{{define "index.tmpl"}}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.AppName}} Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="/assets/styles.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark py-3">
        <div class="container-fluid">
            <div>
                <span class="navbar-brand">{{.AppName}} Monitoring</span>
                <span class="badge ms-2">Realtime</span>
            </div>
            <div class="text-secondary small">
                Last refresh <span id="last-refresh">—</span>
            </div>
        </div>
    </nav>

    <main class="container-fluid py-4">
        <div class="view-switcher mb-4">
            <div class="switcher-track">
                <button class="nav-pill active" id="overview-pill">Overview</button>
                <div class="nav-scroll" id="exchange-menu"></div>
            </div>
            <div class="nav-scroll secondary d-none" id="market-menu"></div>
        </div>

        <section id="overview-view">
        <section class="dashboard-header">
            <div>
                <h1 class="mb-1">Operations Overview</h1>
                <p>CloudWatch-inspired control plane for CryptoFlow collectors.</p>
            </div>
            <div class="summary-grid">
                <div class="summary-card">
                    <span class="summary-label">Active Metrics</span>
                    <span class="summary-value" id="summary-metrics">0</span>
                    <span class="summary-subtext">within current window</span>
                </div>
                <div class="summary-card">
                    <span class="summary-label">Drop Events</span>
                    <span class="summary-value" id="drop-count">0</span>
                    <span class="summary-subtext">snapshot · delta · liquidation</span>
                </div>
                <div class="summary-card">
                    <span class="summary-label">Log Entries</span>
                    <span class="summary-value" id="summary-logs">0</span>
                    <span class="summary-subtext">retained in memory</span>
                </div>
            </div>
        </section>

        <div class="row g-4 align-items-stretch">
            <div class="col-12 col-xxl-8">
                <div class="card shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 mb-1">Channel Buffer Occupancy</h2>
                            <p class="mb-0">Live size of Go channels driving the ingestion pipeline.</p>
                        </div>
                        <span class="badge bg-primary">Live</span>
                    </div>
                    <div class="card-body">
                        <canvas id="channelSizeChart" height="260"></canvas>
                        <div id="channelChartFallback" class="chart-fallback text-muted small d-none">Chart renderer unavailable. Metrics will continue updating below.</div>
                        <div class="text-muted small mt-3" id="channel-capacities">Buffer capacities —</div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-xxl-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header">
                        <h2 class="h5 mb-1">EC2 Resource Utilization</h2>
                        <p class="mb-0">Host CPU, memory and disk usage sampled locally.</p>
                    </div>
                    <div class="card-body">
                        <div class="resource-summary mb-3">
                            <div>
                                <span class="resource-label">CPU</span>
                                <span class="resource-value" id="cpu-stat">--%</span>
                            </div>
                            <div>
                                <span class="resource-label">Memory</span>
                                <span class="resource-value" id="memory-stat">--%</span>
                                <span class="resource-footnote" id="memory-detail">—</span>
                            </div>
                            <div>
                                <span class="resource-label">Disk</span>
                                <span class="resource-value" id="disk-stat">--%</span>
                                <span class="resource-footnote" id="disk-detail">—</span>
                            </div>
                        </div>
                        <canvas id="resourceChart" height="220"></canvas>
                        <div id="resourceChartFallback" class="chart-fallback text-muted small d-none">Chart renderer unavailable. Resource utilisation will continue updating above.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mt-4">
            <div class="card-header">
                <h2 class="h5 mb-1">Channel Drop Monitor</h2>
                <p class="mb-0">Dropped snapshot, delta and liquidation messages per exchange.</p>
            </div>
            <div class="card-body">
                <div class="row g-3" id="drop-grid"></div>
            </div>
        </div>

        <div class="row g-4 mt-1">
            <div class="col-12 col-xl-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h2 class="h5 mb-0">Metrics</h2>
                        <span class="badge bg-primary" id="metrics-count">0</span>
                    </div>
                    <div class="card-body table-wrapper">
                        <table class="table table-dark table-hover align-middle" id="metrics-table">
                            <thead>
                                <tr>
                                    <th scope="col">Timestamp</th>
                                    <th scope="col">Component</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Value</th>
                                    <th scope="col">Type</th>
                                    <th scope="col">Fields</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-12 col-xl-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h2 class="h5 mb-0">Logs</h2>
                        <span class="badge bg-info" id="logs-count">0</span>
                    </div>
                    <div class="card-body table-wrapper">
                        <table class="table table-dark table-striped table-hover align-middle logs-table" id="logs-table">
                            <thead>
                                <tr>
                                    <th scope="col">Timestamp</th>
                                    <th scope="col">Level</th>
                                    <th scope="col">Component</th>
                                    <th scope="col">Message</th>
                                    <th scope="col">Fields</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        </section>

        <section id="market-view" class="d-none">
            <div class="card shadow-sm mb-4">
                <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-start gap-3">
                    <div>
                        <h1 class="mb-1" id="market-title">Select a market</h1>
                        <p class="text-muted mb-0" id="market-description">Use the slider above to drill into an exchange market.</p>
                    </div>
                    <button class="btn btn-outline-light btn-sm" id="back-to-overview">Back to overview</button>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-12 col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header">
                            <h2 class="h5 mb-0">Configuration</h2>
                        </div>
                        <div class="card-body" id="market-config">
                            <p class="text-muted mb-0">Select a market to view its configuration.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header">
                            <h2 class="h5 mb-0">Symbols</h2>
                        </div>
                        <div class="card-body" id="market-symbols">
                            <p class="text-muted mb-0">Symbols collected for the selected market appear here.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header">
                            <h2 class="h5 mb-0">Channel Buffers</h2>
                        </div>
                        <div class="card-body" id="market-channels">
                            <p class="text-muted mb-0">Buffer sizes become available when a market is selected.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Drop Metrics</h2>
                    <span class="badge bg-warning text-dark" id="market-drop-total">0</span>
                </div>
                <div class="card-body" id="market-drops">
                    <p class="text-muted mb-0">Awaiting market selection.</p>
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Market Logs</h2>
                    <span class="badge bg-info" id="market-logs-count">0</span>
                </div>
                <div class="card-body table-wrapper">
                    <table class="table table-dark table-striped table-hover align-middle logs-table">
                        <thead>
                            <tr>
                                <th scope="col">Timestamp</th>
                                <th scope="col">Level</th>
                                <th scope="col">Component</th>
                                <th scope="col">Message</th>
                                <th scope="col">Fields</th>
                            </tr>
                        </thead>
                        <tbody id="market-logs-table"></tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.6/dist/chart.umd.min.js" integrity="sha384-McpAkMSS6Z7dHLF0sWvZOtJLm51DkJKJbZUJ+EGiUZTZ20ins2v72Dg2IYjeo6V5" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0"></script>
    <script>
        const refreshInterval = {{.RefreshIntervalMs}};

        const channelSeriesConfig = {
            fobs_raw_buffer_length: { label: 'Snapshots Raw', color: '#40c4ff' },
            fobs_norm_buffer_length: { label: 'Snapshots Normalised', color: '#f39c12' },
            fobd_raw_buffer_length: { label: 'Deltas Raw', color: '#e85d75' },
            fobd_norm_buffer_length: { label: 'Deltas Normalised', color: '#9b59b6' },
            liq_raw_buffer_length: { label: 'Liquidations Raw', color: '#4dd2a5' },
            liq_norm_buffer_length: { label: 'Liquidations Normalised', color: '#2ecc71' },
            foi_raw_buffer_length: { label: 'Open Interest Raw', color: '#1abc9c' },
            foi_norm_buffer_length: { label: 'Open Interest Normalised', color: '#16a085' },
            pi_raw_buffer_length: { label: 'Premium Index Raw', color: '#e67e22' },
            pi_norm_buffer_length: { label: 'Premium Index Normalised', color: '#d35400' },
            fpi_raw_buffer_length: { label: 'FPI Raw', color: '#9b59b6' },
            fpi_norm_buffer_length: { label: 'FPI Normalised', color: '#8e44ad' },
        };

        const dropMetricMap = {
            snapshot_messages_dropped: 'snapshot',
            delta_messages_dropped: 'delta',
            delta_norm_messages_dropped: 'delta_norm',
            liquidation_messages_dropped: 'liquidation',
            open_interest_messages_dropped: 'open_interest',
            premium_index_messages_dropped: 'premium_index',
        };

        const dropLabels = {
            snapshot: 'Snapshot',
            delta: 'Delta',
            delta_norm: 'Delta Norm',
            liquidation: 'Liquidation',
            open_interest: 'Open Interest',
            premium_index: 'Premium Index',
        };

        let channelChart;
        let resourceChart;
        const chartAvailable = typeof window.Chart !== 'undefined';
        let exchangeMetadata = [];
        let selectedExchange = null;
        let selectedMarket = null;
        let currentView = 'overview';

        function formatFields(fields) {
            if (!fields || Object.keys(fields).length === 0) {
                return '<span class="text-muted">—</span>';
            }
            try {
                return '<code>' + JSON.stringify(fields) + '</code>';
            } catch (err) {
                return '<code>' + String(fields) + '</code>';
            }
        }

        async function fetchJSON(url) {
            const response = await fetch(url);
            if (!response.ok) {
                throw new Error(`Failed to fetch ${url}`);
            }
            return response.json();
        }

        async function fetchMetrics() {
            const data = await fetchJSON('/api/metrics');
            return data.metrics || [];
        }

        async function fetchLogs() {
            const data = await fetchJSON('/api/logs');
            return data.logs || [];
        }

        async function fetchResources() {
            const data = await fetchJSON('/api/resources');
            return data.resources || [];
        }

        function updateTable(tableBody, rows, columns) {
            tableBody.innerHTML = rows.map(row => {
                return `<tr>${columns.map(col => `<td>${row[col]}</td>`).join('')}</tr>`;
            }).join('');
        }

        function updateMetricsTable(metrics) {
            const body = document.querySelector('#metrics-table tbody');
            const rows = metrics.map(metric => ({
                timestamp: new Date(metric.timestamp).toLocaleString(),
                component: metric.component || '<span class="text-muted">—</span>',
                name: `<span class="fw-semibold">${metric.name}</span>`,
                value: `<code>${metric.value}</code>`,
                type: metric.type,
                fields: formatFields(metric.fields),
            }));
            updateTable(body, rows, ['timestamp', 'component', 'name', 'value', 'type', 'fields']);
            document.getElementById('metrics-count').textContent = metrics.length;
            document.getElementById('summary-metrics').textContent = metrics.length;
        }

        function buildLogRows(logs) {
            return logs.map(log => ({
                timestamp: new Date(log.timestamp).toLocaleString(),
                level: `<span class="badge level-${log.level}">${log.level.toUpperCase()}</span>`,
                component: log.component || '<span class="text-muted">—</span>',
                message: `<span class="text-break">${log.message}</span>`,
                fields: formatFields(log.fields),
            }));
        }

        function updateLogsTable(logs) {
            const body = document.querySelector('#logs-table tbody');
            updateTable(body, buildLogRows(logs), ['timestamp', 'level', 'component', 'message', 'fields']);
            document.getElementById('logs-count').textContent = logs.length;
            document.getElementById('summary-logs').textContent = logs.length;
        }

        function renderMarketLogs(logs) {
            const body = document.getElementById('market-logs-table');
            if (!body) {
                return;
            }
            updateTable(body, buildLogRows(logs), ['timestamp', 'level', 'component', 'message', 'fields']);
            const badge = document.getElementById('market-logs-count');
            if (badge) {
                badge.textContent = logs.length;
            }
        }

        function showChartFallback(canvasId, fallbackId) {
            const canvas = document.getElementById(canvasId);
            const fallback = document.getElementById(fallbackId);
            if (canvas) {
                canvas.classList.add('d-none');
            }
            if (fallback) {
                fallback.classList.remove('d-none');
            }
        }

        function initialiseCharts() {
            if (!chartAvailable) {
                console.warn('Chart.js not detected; skipping chart initialisation.');
                showChartFallback('channelSizeChart', 'channelChartFallback');
                showChartFallback('resourceChart', 'resourceChartFallback');
                return;
            }
            const channelCtx = document.getElementById('channelSizeChart');
            channelChart = new Chart(channelCtx, {
                type: 'line',
                data: { datasets: [] },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: false,
                    scales: {
                        x: {
                            type: 'time',
                            time: { tooltipFormat: 'PPpp' },
                            ticks: { color: 'rgba(245,247,255,0.7)' },
                            grid: { color: 'rgba(94,125,179,0.15)' }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: { color: 'rgba(245,247,255,0.7)' },
                            grid: { color: 'rgba(94,125,179,0.2)' }
                        }
                    },
                    plugins: {
                        legend: {
                            labels: { color: 'rgba(245,247,255,0.85)' }
                        }
                    }
                }
            });

            const resourceCtx = document.getElementById('resourceChart');
            resourceChart = new Chart(resourceCtx, {
                type: 'line',
                data: {
                    datasets: [
                        { label: 'CPU %', borderColor: '#40c4ff', backgroundColor: '#40c4ff', tension: 0.3, data: [], pointRadius: 0 },
                        { label: 'Memory %', borderColor: '#f39c12', backgroundColor: '#f39c12', tension: 0.3, data: [], pointRadius: 0 },
                        { label: 'Disk %', borderColor: '#4dd2a5', backgroundColor: '#4dd2a5', tension: 0.3, data: [], pointRadius: 0 },
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: false,
                    scales: {
                        x: {
                            type: 'time',
                            time: { tooltipFormat: 'PPpp' },
                            ticks: { color: 'rgba(245,247,255,0.7)' },
                            grid: { color: 'rgba(94,125,179,0.15)' }
                        },
                        y: {
                            beginAtZero: true,
                            max: 100,
                            ticks: { color: 'rgba(245,247,255,0.7)', callback: value => `${value}%` },
                            grid: { color: 'rgba(94,125,179,0.2)' }
                        }
                    },
                    plugins: {
                        legend: {
                            labels: { color: 'rgba(245,247,255,0.85)' }
                        }
                    }
                }
            });
        }

        function updateChannelChart(metrics) {
            if (!channelChart) {
                return;
            }
            const dataBySeries = {};
            const capacities = {};
            Object.keys(channelSeriesConfig).forEach(key => { dataBySeries[key] = []; });

            for (const metric of metrics) {
                const series = channelSeriesConfig[metric.name];
                if (!series) {
                    continue;
                }
                const value = Number(metric.value);
                if (!Number.isFinite(value)) {
                    continue;
                }
                const timestamp = new Date(metric.timestamp);
                if (Number.isNaN(timestamp.getTime())) {
                    continue;
                }
                dataBySeries[metric.name].push({ x: timestamp, y: value });
                if (metric.fields && metric.fields.capacity !== undefined) {
                    capacities[metric.name] = metric.fields.capacity;
                }
            }

            channelChart.data.datasets = Object.entries(channelSeriesConfig).map(([name, config]) => ({
                label: config.label,
                data: dataBySeries[name].sort((a, b) => a.x - b.x).slice(-150),
                borderColor: config.color,
                backgroundColor: config.color,
                borderWidth: 2,
                tension: 0.25,
                fill: false,
                pointRadius: 0,
            }));

            channelChart.update('none');
            updateChannelCapacities(capacities);
        }

        function updateChannelCapacities(capacities) {
            const container = document.getElementById('channel-capacities');
            const parts = [];
            Object.entries(channelSeriesConfig).forEach(([name, cfg]) => {
                if (capacities[name] !== undefined) {
                    parts.push(`<span class="me-3">${cfg.label}: <code>${capacities[name]}</code></span>`);
                }
            });
            container.innerHTML = parts.length ? `Buffer capacities — ${parts.join('')}` : 'Buffer capacities — <span class="text-muted">awaiting samples</span>';
        }

        function updateResourceChart(resources) {
            if (!resourceChart) {
                return;
            }
            const cpuData = [];
            const memoryData = [];
            const diskData = [];
            for (const sample of resources) {
                const ts = new Date(sample.timestamp);
                if (Number.isNaN(ts.getTime())) {
                    continue;
                }
                cpuData.push({ x: ts, y: Number(sample.cpu_percent) || 0 });
                memoryData.push({ x: ts, y: Number(sample.memory_percent) || 0 });
                diskData.push({ x: ts, y: Number(sample.disk_percent) || 0 });
            }
            resourceChart.data.datasets[0].data = cpuData.slice(-180);
            resourceChart.data.datasets[1].data = memoryData.slice(-180);
            resourceChart.data.datasets[2].data = diskData.slice(-180);
            resourceChart.update('none');
        }

        function formatBytes(bytes) {
            const value = Number(bytes);
            if (!Number.isFinite(value) || value <= 0) {
                return '—';
            }
            const units = ['B', 'KB', 'MB', 'GB', 'TB'];
            let unit = 0;
            let scaled = value;
            while (scaled >= 1024 && unit < units.length - 1) {
                scaled /= 1024;
                unit++;
            }
            const precision = unit >= 2 ? 1 : 0;
            return `${scaled.toFixed(precision)} ${units[unit]}`;
        }

        function updateResourceSummary(resources) {
            const cpuEl = document.getElementById('cpu-stat');
            const memEl = document.getElementById('memory-stat');
            const memDetail = document.getElementById('memory-detail');
            const diskEl = document.getElementById('disk-stat');
            const diskDetail = document.getElementById('disk-detail');

            if (!resources || resources.length === 0) {
                cpuEl.textContent = memEl.textContent = diskEl.textContent = '--%';
                memDetail.textContent = diskDetail.textContent = '—';
                return;
            }

            const latest = resources[resources.length - 1];
            cpuEl.textContent = Number.isFinite(Number(latest.cpu_percent)) ? `${Number(latest.cpu_percent).toFixed(1)}%` : '--%';
            memEl.textContent = Number.isFinite(Number(latest.memory_percent)) ? `${Number(latest.memory_percent).toFixed(1)}%` : '--%';
            diskEl.textContent = Number.isFinite(Number(latest.disk_percent)) ? `${Number(latest.disk_percent).toFixed(1)}%` : '--%';
            memDetail.textContent = `${formatBytes(latest.memory_used)} / ${formatBytes(latest.memory_total)}`;
            diskDetail.textContent = `${formatBytes(latest.disk_used)} / ${formatBytes(latest.disk_total)}`;
        }

        function aggregateDropMetrics(metrics) {
            const aggregates = {};
            Object.keys(dropLabels).forEach(key => { aggregates[key] = {}; });
            for (const metric of metrics) {
                const category = dropMetricMap[metric.name];
                if (!category) {
                    continue;
                }
                const value = Number(metric.value) || 0;
                const fields = metric.fields || {};
                const exchange = fields.exchange || 'unknown';
                aggregates[category][exchange] = (aggregates[category][exchange] || 0) + value;
            }
            return aggregates;
        }

        function renderDropCards(aggregates) {
            const container = document.getElementById('drop-grid');
            const exchanges = new Set();
            Object.values(aggregates).forEach(map => Object.keys(map).forEach(name => exchanges.add(name)));

            if (exchanges.size === 0) {
                container.innerHTML = '<div class="col-12"><p class="text-muted text-center mb-0">No dropped messages observed in the current retention window.</p></div>';
                document.getElementById('drop-count').textContent = '0';
                return;
            }

            let total = 0;
            const cards = Array.from(exchanges).sort().map(exchange => {
                const rows = Object.keys(dropLabels).map(category => {
                    const value = aggregates[category][exchange] || 0;
                    total += value;
                    return `
                        <div>
                            <span class="mini-label">${dropLabels[category]}</span>
                            <span class="mini-value">${value}</span>
                        </div>`;
                }).join('');
                return `
                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="mini-card">
                            <div class="mini-card-title text-uppercase">${exchange}</div>
                            <div class="mini-stats">
                                ${rows}
                            </div>
                        </div>
                    </div>`;
            }).join('');

            container.innerHTML = cards;
            document.getElementById('drop-count').textContent = total;
        }

        function updateLastRefresh() {
            document.getElementById('last-refresh').textContent = new Date().toLocaleTimeString();
        }

        async function refreshOverview() {
            try {
                const [metrics, logs, resources] = await Promise.all([
                    fetchMetrics(),
                    fetchLogs(),
                    fetchResources(),
                ]);
                updateMetricsTable(metrics);
                updateLogsTable(logs);
                updateChannelChart(metrics);
                renderDropCards(aggregateDropMetrics(metrics));
                updateResourceChart(resources);
                updateResourceSummary(resources);
                updateLastRefresh();
            } catch (error) {
                console.error('Dashboard refresh failed', error);
            }
        }

        async function refreshMarketDetail(exchange, market, renderView = false) {
            if (!exchange || !market) {
                return;
            }
            try {
                const detail = await fetchJSON(`/api/exchanges/${exchange}/${market}`);
                if (renderView) {
                    renderMarketDetail(detail);
                } else {
                    updateMarketPanels(detail);
                }
                updateLastRefresh();
            } catch (error) {
                console.error('Market refresh failed', error);
            }
        }

        function renderMarketDetail(detail) {
            currentView = 'market';
            document.getElementById('overview-view').classList.add('d-none');
            document.getElementById('market-view').classList.remove('d-none');
            document.getElementById('market-menu').classList.remove('d-none');
            updateMarketPanels(detail);
        }

        function updateMarketPanels(detail) {
            if (!detail || !detail.market) {
                return;
            }
            const titleEl = document.getElementById('market-title');
            const descEl = document.getElementById('market-description');
            if (titleEl) {
                titleEl.textContent = `${detail.exchange.display_name} / ${detail.market.display_name}`;
            }
            if (descEl) {
                descEl.textContent = detail.market.description || 'Live pipeline view for the selected market.';
            }
            renderConfigList(detail.market.config);
            renderSymbolList(detail.market.symbols);
            renderChannelStats(detail.channels);
            renderMarketDrops(detail.drops);
            renderMarketLogs(detail.logs || []);
        }

        function renderConfigList(config) {
            const container = document.getElementById('market-config');
            if (!container) {
                return;
            }
            if (!config || Object.keys(config).length === 0) {
                container.innerHTML = '<p class="text-muted mb-0">No explicit overrides configured for this market.</p>';
                return;
            }
            const rows = Object.entries(config).map(([key, value]) => `
                <div class="config-row">
                    <span class="config-key">${key}</span>
                    <span class="config-value"><code>${value}</code></span>
                </div>`).join('');
            container.innerHTML = rows;
        }

        function renderSymbolList(symbols) {
            const container = document.getElementById('market-symbols');
            if (!container) {
                return;
            }
            if (!symbols || symbols.length === 0) {
                container.innerHTML = '<p class="text-muted mb-0">No symbols are currently allocated to this market.</p>';
                return;
            }
            container.innerHTML = symbols.map(symbol => `<span class="symbol-pill">${symbol}</span>`).join('');
        }

        function renderChannelStats(channelData) {
            const container = document.getElementById('market-channels');
            if (!container) {
                return;
            }
            if (!channelData || Object.keys(channelData).length === 0) {
                container.innerHTML = '<p class="text-muted mb-0">Awaiting channel metrics for this market.</p>';
                return;
            }
            const rows = Object.entries(channelData).map(([metric, series]) => {
                const label = (channelSeriesConfig[metric] && channelSeriesConfig[metric].label) || metric;
                const latest = series.samples && series.samples.length > 0 ? series.samples[series.samples.length - 1].value : null;
                const capacity = series.capacity ? `<span class="mini-footnote text-muted">Capacity ${series.capacity}</span>` : '<span class="mini-footnote text-muted">Capacity —</span>';
                const value = Number.isFinite(latest) ? latest : '—';
                return `
                    <div class="channel-row">
                        <div>
                            <span class="channel-label">${label}</span>
                            ${capacity}
                        </div>
                        <div class="channel-value">${value}</div>
                    </div>`;
            }).join('');
            container.innerHTML = rows;
        }

        function renderMarketDrops(drops) {
            const container = document.getElementById('market-drops');
            if (!container) {
                return;
            }
            if (!drops || Object.keys(drops).length === 0) {
                container.innerHTML = '<p class="text-muted mb-0">No drop metrics recorded for this market.</p>';
                document.getElementById('market-drop-total').textContent = '0';
                return;
            }
            const rows = Object.keys(dropLabels).map(key => {
                const value = drops[key] || 0;
                return `
                    <div class="drop-row">
                        <span class="drop-label">${dropLabels[key]}</span>
                        <span class="drop-value">${value}</span>
                    </div>`;
            }).join('');
            const total = Object.values(drops).reduce((acc, val) => acc + Number(val || 0), 0);
            document.getElementById('market-drop-total').textContent = total;
            container.innerHTML = rows;
        }

        function findExchange(name) {
            if (!name) {
                return null;
            }
            return exchangeMetadata.find(ex => ex.name.toLowerCase() === name.toLowerCase()) || null;
        }

        function renderExchangeMenu() {
            const container = document.getElementById('exchange-menu');
            if (!container) {
                return;
            }
            container.innerHTML = exchangeMetadata.map(ex => `
                <button class="nav-pill" data-exchange="${ex.name}">${ex.display_name}</button>`).join('');
            container.querySelectorAll('button').forEach(btn => {
                btn.addEventListener('click', () => {
                    const exchange = btn.dataset.exchange;
                    selectExchange(exchange);
                });
            });
        }

        function selectExchange(name) {
            const exchange = findExchange(name);
            if (!exchange) {
                return;
            }
            selectedExchange = exchange.name;
            renderMarketMenu(exchange);
            highlightPills();
        }

        function renderMarketMenu(exchange) {
            const container = document.getElementById('market-menu');
            if (!container) {
                return;
            }
            if (!exchange || !exchange.markets || exchange.markets.length === 0) {
                container.innerHTML = '<span class="text-muted small ps-2">No active markets.</span>';
                container.classList.add('d-none');
                return;
            }
            container.innerHTML = exchange.markets.map(market => `
                <button class="nav-pill" data-market="${market.key}">${market.display_name}</button>`).join('');
            container.querySelectorAll('button').forEach(btn => {
                btn.addEventListener('click', () => {
                    const marketKey = btn.dataset.market;
                    window.location.hash = `${exchange.name}/${marketKey}`;
                });
            });
            container.classList.remove('d-none');
        }

        function highlightPills() {
            document.querySelectorAll('#exchange-menu .nav-pill').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.exchange === selectedExchange);
            });
            document.querySelectorAll('#market-menu .nav-pill').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.market === selectedMarket);
            });
            document.getElementById('overview-pill').classList.toggle('active', currentView === 'overview');
        }

        function showOverview() {
            currentView = 'overview';
            selectedMarket = null;
            document.getElementById('overview-view').classList.remove('d-none');
            document.getElementById('market-view').classList.add('d-none');
            document.getElementById('market-menu').classList.add('d-none');
            highlightPills();
        }

        async function navigateToMarket(exchangeName, marketKey, fromHash = false) {
            const exchange = findExchange(exchangeName);
            if (!exchange) {
                return;
            }
            const market = exchange.markets.find(m => m.key === marketKey);
            if (!market) {
                return;
            }
            selectedExchange = exchange.name;
            selectedMarket = market.key;
            renderMarketMenu(exchange);
            highlightPills();
            if (!fromHash) {
                window.location.hash = `${exchange.name}/${market.key}`;
                return;
            }
            await refreshMarketDetail(exchange.name, market.key, true);
        }

        async function loadMetadata() {
            try {
                const data = await fetchJSON('/api/exchanges');
                exchangeMetadata = data.exchanges || [];
                renderExchangeMenu();
            } catch (error) {
                console.error('Failed to load exchange metadata', error);
            }
        }

        function handleHashChange() {
            const hash = window.location.hash.replace('#', '').trim();
            if (!hash || hash === 'overview') {
                showOverview();
                return;
            }
            const [exchange, market] = hash.split('/');
            if (!exchange || !market) {
                showOverview();
                return;
            }
            selectExchange(exchange);
            navigateToMarket(exchange, market, true);
        }

        async function refresh() {
            if (currentView === 'market' && selectedExchange && selectedMarket) {
                await refreshMarketDetail(selectedExchange, selectedMarket, false);
            } else {
                await refreshOverview();
            }
        }

        document.addEventListener('DOMContentLoaded', async () => {
            await loadMetadata();
            initialiseCharts();
            document.getElementById('overview-pill').addEventListener('click', () => {
                window.location.hash = 'overview';
            });
            document.getElementById('back-to-overview').addEventListener('click', () => {
                window.location.hash = 'overview';
            });
            window.addEventListener('hashchange', handleHashChange);
            handleHashChange();
            refresh();
            setInterval(refresh, Math.max(refreshInterval, 1000));
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
{{end}}
